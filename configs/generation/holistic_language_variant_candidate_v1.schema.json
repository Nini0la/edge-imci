{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgeimci.local/schemas/holistic_language_variant_candidate_v1.schema.json",
  "title": "Teacher-returned EdgeIMCI PHC input-language candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_schema_id",
    "semantic_case_id",
    "strategy_id",
    "user_submission",
    "fact_evidence"
  ],
  "properties": {
    "candidate_schema_id": {
      "const": "edge-imci-holistic-language-variant-candidate-v1"
    },
    "semantic_case_id": {
      "type": "string",
      "pattern": "^hpg-[0-9]{3}-.+$"
    },
    "strategy_id": {
      "enum": [
        "phc-concise-complete-v1",
        "phc-natural-complete-v1"
      ]
    },
    "user_submission": {
      "type": "string",
      "minLength": 20,
      "maxLength": 12000
    },
    "fact_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "source_value_sha256", "evidence_text"],
        "properties": {
          "fact_id": {
            "type": "string",
            "minLength": 1
          },
          "source_value_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "evidence_text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
