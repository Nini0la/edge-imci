{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgeimci.local/schemas/holistic_teacher_canary_selection_v1.schema.json",
  "title": "EdgeIMCI deterministic teacher canary selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selection_id",
    "selection_version",
    "status",
    "source_pins",
    "prompt_strategy_ids",
    "strata",
    "selected_case_count",
    "expected_request_count",
    "remote_calls_authorized"
  ],
  "properties": {
    "selection_id": {"const": "edge-imci-holistic-teacher-canary-selection-v1"},
    "selection_version": {"const": "1.0.0"},
    "status": {"const": "SELECTED_NOT_AUTHORIZED_FOR_REMOTE_CALLS"},
    "source_pins": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_cases_sha256",
        "teacher_bakeoff_config_sha256",
        "language_variant_contract_sha256"
      ],
      "properties": {
        "semantic_cases_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "teacher_bakeoff_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "language_variant_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "prompt_strategy_ids": {
      "type": "array",
      "const": ["phc-concise-complete-v1", "phc-natural-complete-v1"]
    },
    "strata": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stratum_id", "selection_rule", "selected_case_id", "purpose"],
        "properties": {
          "stratum_id": {"type": "string", "minLength": 1},
          "selection_rule": {"type": "string", "minLength": 1},
          "selected_case_id": {"type": "string", "pattern": "^hpg-[0-9]{3}-.+$"},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "selected_case_count": {"const": 6},
    "expected_request_count": {"const": 12},
    "remote_calls_authorized": {"const": false}
  }
}
