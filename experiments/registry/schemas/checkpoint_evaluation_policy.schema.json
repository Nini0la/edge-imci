{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://edgeimci.local/schemas/checkpoint-evaluation-policy-1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evaluation_id", "dataset", "controls", "promotion"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "partition", "expected_record_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "partition": {"const": "VALIDATION"},
        "expected_record_count": {"type": "integer", "minimum": 1}
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_partition_prohibited", "missing_predictions_score_as_failures"],
      "properties": {
        "test_partition_prohibited": {"const": true},
        "missing_predictions_score_as_failures": {"const": true}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_minimums", "per_style_minimums", "ranking_order"],
      "properties": {
        "global_minimums": {"$ref": "#/$defs/thresholds"},
        "per_style_minimums": {"$ref": "#/$defs/thresholds"},
        "ranking_order": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "thresholds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}
    }
  }
}
